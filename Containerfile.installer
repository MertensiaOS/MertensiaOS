## MertensiaOS generic live installer.
ARG BASE_IMAGE=localhost/mertensiaos:base

## Stage file inputs on an empty filesystem to avoid diffing the full OS for each COPY.
FROM scratch AS installer-files
COPY installer /installer
COPY branding/fonts /branding/fonts

FROM scratch AS installer-applications
COPY src/mertensia/installer /usr/lib/mertensia/python/mertensia/installer

FROM scratch AS installer-build-scripts
COPY scripts/configure-installer.sh scripts/install-image-files.py scripts/installer-files.json /

FROM ${BASE_IMAGE}

ARG SOURCE_IMAGE=localhost/mertensiaos:base
ARG TARGET_IMAGE=localhost/mertensiaos:base
ARG BUILD_MODE=development

RUN --mount=type=cache,id=mertensia-installer-dnf45,target=/var/cache/libdnf5,sharing=locked \
    dnf -y --setopt=keepcache=True install \
    dracut-live \
    dracut-config-generic \
    dracut-network \
    squashfs-tools \
    grub2-efi-x64-cdboot \
    grub2-tools-extra \
    shim-x64 \
    xorriso \
    isomd5sum \
    gdisk \
    dosfstools \
    e2fsprogs \
    util-linux \
    systemd-udev \
    podman \
    skopeo \
    && test -r /usr/lib64/cryptsetup/libcryptsetup-token-systemd-tpm2.so

RUN --mount=type=bind,from=installer-files,target=/run/mertensia-files,ro \
    --mount=type=bind,from=installer-build-scripts,target=/run/mertensia-build,ro \
    python3 /run/mertensia-build/install-image-files.py \
      /run/mertensia-build/installer-files.json /run/mertensia-files / && \
    bash /run/mertensia-build/configure-installer.sh

## Application edits reuse the configured OS and initramfs.
COPY --from=installer-applications / /
