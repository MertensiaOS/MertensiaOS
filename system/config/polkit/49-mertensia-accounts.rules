polkit.addRule(function(action, subject) {
    if (action.id == "org.mertensia.accounts.manage" &&
        subject.user == "mertensia-setup") {
        if (!subject.active || !subject.local) {
            return polkit.Result.NO;
        }
        try {
            var status = polkit.spawn(["/usr/libexec/mertensia-setup-authorized"]);
            return status.indexOf("authorized") === 0 ?
                polkit.Result.YES : polkit.Result.NO;
        } catch (error) {
            return polkit.Result.NO;
        }
    }
    if (action.id == "org.mertensia.accounts.manage") {
        // Authenticate the caller directly: group-based admin enumeration may
        // omit homed users and fall back to an unrelated administrator.
        // The helper independently checks wheel membership and setup state.
        if (subject.active && subject.local && subject.isInGroup("wheel")) {
            return polkit.Result.AUTH_SELF_KEEP;
        }
        return polkit.Result.NO;
    }
    // Unlock supported GNOME/AccountsService operations as the signed-in
    // administrator. AccountsService separately rejects traditional account
    // creation; use Mertensia Accounts to create encrypted homes.
    if (action.id == "org.freedesktop.accounts.user-administration" ||
        action.id == "org.gnome.controlcenter.user-accounts.administration") {
        if (subject.active && subject.local && subject.isInGroup("wheel")) {
            return polkit.Result.AUTH_SELF_KEEP;
        }
        return polkit.Result.NO;
    }
});
