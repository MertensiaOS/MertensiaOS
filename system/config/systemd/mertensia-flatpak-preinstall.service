[Unit]
Description=Install MertensiaOS default Flatpak applications
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/usr/bin/mertensia-installer

[Service]
Type=oneshot
ExecStart=/usr/bin/flatpak preinstall --system --noninteractive
TimeoutStartSec=30min
RemainAfterExit=yes

