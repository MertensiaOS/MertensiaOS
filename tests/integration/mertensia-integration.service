[Unit]
Description=Disposable MertensiaOS integration-test agent
ConditionVirtualization=vm
Wants=systemd-homed.service accounts-daemon.service gdm.service
After=systemd-homed.service accounts-daemon.service gdm.service

[Service]
Type=simple
ExecStartPre=-/usr/sbin/modprobe qemu_fw_cfg
ExecStart=/usr/bin/python3 /usr/libexec/mertensia-integration-agent
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
